# ============================================================
#  매뉴얼 음성 도우미 — 환경 변수 예시
#  복사해서 .env 로 만든 뒤 값을 채우세요:  cp .env.example .env
# ============================================================

# ── 앱 ──
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── LLM (답변 생성 / 평가셋 생성) ── gemini | openai | anthropic
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=            # ← Gemini API 키 (https://aistudio.google.com 에서 발급)
# 다른 제공자 쓸 경우
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── 임베딩 (한국어 특화) ──
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda          # cuda | cpu

# ── Reranker (Cross-Encoder) ──
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cuda

# ── 벡터 DB ──
VECTOR_STORE=chroma            # chroma | faiss
VECTOR_INDEX_DIR=data/index

# ── 검색 파라미터 ──
RETRIEVER_TOP_K=5
HYBRID_BM25_WEIGHT=0.5         # BM25 vs 임베딩 가중치 (0~1)
RERANK_TOP_N=20               # reranker 입력 후보 수

# ── STT (음성 → 텍스트) ── whisper | clova
STT_PROVIDER=whisper
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
CLOVA_SPEECH_API_KEY=
CLOVA_SPEECH_INVOKE_URL=

# ── TTS (텍스트 → 음성) ── clova | xtts
TTS_PROVIDER=clova
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=
